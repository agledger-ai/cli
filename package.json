{
  "name": "@agledger/cli",
  "version": "1.0.0",
  "description": "AGLedger CLI — Developer and agent interface for AGLedger",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "agledger": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "SKILL.md",
    "oclif.manifest.json"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "oclif manifest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build",
    "lint:pkg": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run lint:pkg"
  },
  "dependencies": {
    "@agledger/verify-core": "^0.1.3",
    "@oclif/core": "^4.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/node": "^24.0.0",
    "oclif": "^4.23.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "oclif": {
    "bin": "agledger",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agledger-ai/cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://agledger.ai",
  "author": "AGLedger LLC",
  "engines": {
    "node": ">=24.0.0"
  }
}
