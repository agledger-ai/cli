{
  "name": "@agledger/cli",
  "version": "2.2.0",
  "description": "AGLedger CLI: the AGLedger API from the command line, for developers and agents. Self-hosted, signed, hash-chained. Patent pending.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "agledger": "./bin/run.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "LICENSE",
    "SKILL.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "oxlint --type-aware .",
    "pretest": "npm run build",
    "test": "vitest run",
    "deps:lag": "node scripts/dep-lag.mjs",
    "deps:refresh": "npm update && node scripts/dep-lag.mjs",
    "prepack": "node -e \"fs.existsSync('tsconfig.json')&&child_process.execSync('npm run build',{stdio:'inherit'})\"",
    "lint:pkg": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run lint:pkg"
  },
  "dependencies": {
    "@agledger/verify-core": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@types/node": "^24.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "publint": "^0.3.21",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agledger-ai/cli.git"
  },
  "bugs": {
    "url": "https://github.com/agledger-ai/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://agledger.ai",
  "author": "AGLedger LLC",
  "engines": {
    "node": ">=24.0.0"
  }
}
